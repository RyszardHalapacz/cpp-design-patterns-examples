// ==================================
// STRATEGY — funktory sortujące
// ==================================
enum class SortStrategyId {
    Ascending,
    Descending,
    Bubble
};

// Nazwa do logowania/komunikatów — bez tworzenia obiektu strategii tylko po to,
// żeby zapytać go o name(). Osobne źródło prawdy, celowo proste (switch).
inline const char* sortStrategyIdName(SortStrategyId id) {
    switch (id) {
        case SortStrategyId::Ascending:  return "Ascending";
        case SortStrategyId::Descending: return "Descending";
        case SortStrategyId::Bubble:     return "Bubble";
    }
    return "Nieznana";
}

class ISortStrategy {
public:
    virtual ~ISortStrategy() = default;

    // operator() -> to czyni z tego funktor
    virtual void operator()(std::vector<int>& data) const = 0;
    virtual const char* name() const = 0;
    virtual SortStrategyId id() const = 0;
};

// Rosnąco, przez std::sort
class AscendingSortStrategy : public ISortStrategy {
public:
    void operator()(std::vector<int>& data) const override {
        std::sort(data.begin(), data.end());
    }

    const char* name() const override { return "AscendingSort (std::sort)"; }
    SortStrategyId id() const override { return SortStrategyId::Ascending; }
};

// Malejąco, przez std::sort z komparatorem
class DescendingSortStrategy : public ISortStrategy {
public:
    void operator()(std::vector<int>& data) const override {
        std::sort(data.begin(), data.end(), std::greater<int>());
    }

    const char* name() const override { return "DescendingSort (std::sort, greater)"; }
    SortStrategyId id() const override { return SortStrategyId::Descending; }
};

// Ręczny bubble sort — celowo "inna technika", nie std::sort
class BubbleSortStrategy : public ISortStrategy {
public:
    void operator()(std::vector<int>& data) const override {
        if (data.empty()) {
            return;
        }

        for (size_t i = 0; i < data.size() - 1; ++i) {
            for (size_t j = 0; j < data.size() - 1 - i; ++j) {
                if (data[j] > data[j + 1]) {
                    std::swap(data[j], data[j + 1]);
                }
            }
        }
    }

    const char* name() const override { return "BubbleSort (ręczny)"; }
    SortStrategyId id() const override { return SortStrategyId::Bubble; }
};

// ==================================
// FACTORY — tworzy konkretną strategię na podstawie SortStrategyId,
// żeby klient (main, GUI, Configurator) nie musiał znać nazw konkretnych
// klas (AscendingSortStrategy, DescendingSortStrategy, BubbleSortStrategy),
// tylko sam identyfikator — ten sam, którego już używamy do whitelisty
// w Configuratorze.
// ==================================
class SortStrategyFactory {
public:
    static std::unique_ptr<ISortStrategy> create(SortStrategyId id) {
        switch (id) {
            case SortStrategyId::Ascending:
                return std::make_unique<AscendingSortStrategy>();
            case SortStrategyId::Descending:
                return std::make_unique<DescendingSortStrategy>();
            case SortStrategyId::Bubble:
                return std::make_unique<BubbleSortStrategy>();
        }
        throw std::runtime_error("SortStrategyFactory: nieznany SortStrategyId");
    }
};

// ==================================
// ENGINE — teraz też konkretny Observer
// ==================================
class Engine : public ISessionObserver {
public:
    // Domyślna strategia — Engine zawsze ma jakąś, żeby sortVector nigdy nie był "goły".
    // Tworzona przez fabrykę, więc Engine w ogóle nie zna nazwy AscendingSortStrategy.
    Engine() : sortStrategy_(SortStrategyFactory::create(SortStrategyId::Ascending)) {}

    void start() {
        running_ = true;
        logApp("[Engine] Start\n");
    }

    void stop() {
        running_ = false;
        logApp("[Engine] Stop\n");
    }

    void addVector(const std::vector<int>& vec) {
        data_.push_back(vec);
    }

    // STRATEGY — podmiana algorytmu sortowania w locie
    void setSortStrategy(std::unique_ptr<ISortStrategy> strategy) {
        sortStrategy_ = std::move(strategy);

        std::ostringstream oss;
        oss << "[Engine] Ustawiono strategię sortowania: " << sortStrategy_->name() << "\n";
        logApp(oss.str());
    }

    void sortVector(size_t index) {
        if (index >= data_.size()) {
            logApp("[Engine] Niepoprawny indeks wektora\n");
            return;
        }

        std::ostringstream oss;
        oss << "[Engine] Sortuję strategią: " << sortStrategy_->name() << "\n";
        logApp(oss.str());

        (*sortStrategy_)(data_[index]);   // wywołanie funktora
    }

    void printData() const {
        std::ostringstream oss;
        oss << "[Engine] Dane:\n";

        for (size_t i = 0; i < data_.size(); ++i) {
            oss << "  [" << i << "]: ";

            for (int value : data_[i]) {
                oss << value << " ";
            }

            oss << "\n";
        }

        logApp(oss.str());
    }

    // ==================================
    // OBSERVER — reakcja na powiadomienie
    // ==================================
    void onSessionEvent(const SessionEvent& event) override {
        logApp("[Engine] Otrzymano powiadomienie: coś się zmieniło w sesji\n");

        switch (event.type) {
            case SessionEventType::VectorAdded:
                logApp("[Engine] -> rozpoznano: dodanie wektora\n");
                addVector(event.vectorData);
                break;

            case SessionEventType::SortRequested:
                logApp("[Engine] -> rozpoznano: żądanie sortowania\n");
                sortVector(event.index);
                break;

            case SessionEventType::PrintRequested:
                logApp("[Engine] -> rozpoznano: żądanie wypisania danych\n");
                printData();
                break;

            case SessionEventType::StrategyChangeRequested:
                logApp("[Engine] -> rozpoznano: żądanie zmiany strategii sortowania\n");
                // Engine sam tworzy sobie nową strategię przez fabrykę — nikt
                // z zewnątrz nie musi (i nie może) przekazać mu gotowego
                // unique_ptr<ISortStrategy> przez notify(), bo unique_ptr się
                // nie kopiuje, a notify() broadcastuje to samo zdarzenie do
                // wszystkich obserwatorów naraz.
                setSortStrategy(SortStrategyFactory::create(event.strategyId));
                break;

            case SessionEventType::SessionClosing:
                logApp("[Engine] -> rozpoznano: zamykanie sesji, sprzątam i się zatrzymuję\n");
                stop();
                break;
        }
    }

private:
    bool running_ = false;
    std::vector<std::vector<int>> data_;
    std::unique_ptr<ISortStrategy> sortStrategy_;
};

// ==================================
// SESSION MANAGEMENT — FACADE + SUBJECT (Observer)
// ==================================
class SessionManagement {
public:
    void connectToEngine(Engine& engine) {
        engine_ = &engine;

        logApp("[Session] Łączenie z Engine\n");
        logApp("[Session] Sprawdzenie konfiguracji\n");
        logApp("[Session] Engine podłączony\n");

        // Engine automatycznie zapisuje się jako obserwator sesji
        attach(&engine);
    }

    void openSession() {
        if (!engine_) {
            logApp("[Session] Brak Engine\n");
            return;
        }

        sessionActive_ = true;
        logApp("[Session] Otwieram sesję\n");
        engine_->start();
    }

    void closeSession() {
        if (!engine_) {
            logApp("[Session] Brak Engine\n");
            return;
        }

        logApp("[Session] Zamykam sesję — powiadamiam wszystkich obserwatorów\n");
        sessionActive_ = false;

        // Każdy obserwator sam decyduje, co znaczy dla niego "sesja się kończy"
        notify(SessionEvent{SessionEventType::SessionClosing, {}, 0});

        // Sesja jest już martwa — nikt nie jest dłużej obserwowany
        observers_.clear();
    }

    void addVectorFromGui(const std::vector<int>& vec) {
        if (!checkSession()) {
            return;
        }

        logApp("[Session] GUI chce dodać wektor\n");
        notify(SessionEvent{SessionEventType::VectorAdded, vec, 0});
    }

    void sortVectorFromGui(size_t index) {
        if (!checkSession()) {
            return;
        }

        logApp("[Session] GUI chce sortować wektor\n");
        notify(SessionEvent{SessionEventType::SortRequested, {}, index});
    }

    void printDataFromGui() {
        if (!checkSession()) {
            return;
        }

        logApp("[Session] GUI chce wypisać dane\n");
        notify(SessionEvent{SessionEventType::PrintRequested, {}, 0});
    }

    // BUILDER + odroczone wykonanie: sesja jedzie po kolei po paczce poleceń
    // i dla każdego z nich generuje normalny event (dokładnie tak jak przy
    // pojedynczych kliknięciach z GUI) — Observer nie widzi żadnej różnicy.
    void executeBatch(const CommandBatch& batch) {
        std::ostringstream header;
        header << "[Session] Otrzymano paczkę poleceń (" << batch.size() << ") — wykonuję po kolei\n";
        logApp(header.str());

        for (const Command& command : batch) {
            switch (command.type) {
                case CommandType::AddVector:
                    addVectorFromGui(command.vectorData);
                    break;

                case CommandType::SortVector:
                    sortVectorFromGui(command.index);
                    break;

                case CommandType::PrintData:
                    printDataFromGui();
                    break;
            }
        }

        logApp("[Session] Paczka poleceń wykonana w całości\n");
    }

    // Fasada nad Strategy — GUI/main nie musi znać klasy Engine ani żadnej
    // konkretnej klasy strategii. SessionManagement nie tworzy już strategii
    // (to robi teraz sam Engine, przez SortStrategyFactory) — tutaj tylko
    // sprawdzamy politykę Configuratora i rozsyłamy KOPIOWALNY SortStrategyId
    // przez ten sam mechanizm notify(), którym idą inne zdarzenia.
    void setSortStrategyFromGui(SortStrategyId id) {
        if (!engine_) {
            logApp("[Session] Brak Engine\n");
            return;
        }

        if (!isStrategyAllowed(id)) {
            std::ostringstream oss;
            oss << "[Session] Strategia \"" << sortStrategyIdName(id)
                << "\" niedozwolona — Configurator jej nie autoryzował\n";
            logApp(oss.str());
            return;
        }

        logApp("[Session] GUI prosi o zmianę strategii sortowania\n");
        notify(SessionEvent{SessionEventType::StrategyChangeRequested, {}, 0, id});
    }

    // Configurator jako jedyny ustala, co wolno podmieniać w locie
    void setAllowedStrategies(std::vector<SortStrategyId> allowed) {
        allowedStrategies_ = std::move(allowed);
    }

    // ==================================
    // OBSERVER — zarządzanie subskrybentami
    // ==================================
    void attach(ISessionObserver* observer) {
        observers_.push_back(observer);
    }

    void detach(ISessionObserver* observer) {
        observers_.erase(
            std::remove(observers_.begin(), observers_.end(), observer),
            observers_.end());
    }

private:
    void notify(const SessionEvent& event) {
        for (ISessionObserver* observer : observers_) {
            observer->onSessionEvent(event);
        }
    }

    bool isStrategyAllowed(SortStrategyId id) const {
        return std::find(allowedStrategies_.begin(), allowedStrategies_.end(), id)
               != allowedStrategies_.end();
    }

    bool checkSession() const {
        if (!engine_) {
            logApp("[Session] Brak Engine\n");
            return false;
        }

        if (!sessionActive_) {
            logApp("[Session] Sesja nieaktywna\n");
            return false;
        }

        return true;
    }

private:
    Engine* engine_ = nullptr;
    bool sessionActive_ = false;
    std::vector<ISessionObserver*> observers_;
    std::vector<SortStrategyId> allowedStrategies_;
};

// ==================================
// DUMMY GUI
// ==================================
class DummyGui {
public:
    using AddVectorFunc = void (SessionManagement::*)(const std::vector<int>&);
    using SortVectorFunc = void (SessionManagement::*)(size_t);
    using PrintDataFunc = void (SessionManagement::*)();
    using ExecuteBatchFunc = void (SessionManagement::*)(const CommandBatch&);
    using SetSortStrategyFunc = void (SessionManagement::*)(SortStrategyId);

    // GUI nie jest właścicielem SessionManagement. Przechowuje tylko weak_ptr,
    // więc zniszczenie sesji nie pozostawi wiszącego surowego wskaźnika.
    void connectAddVector(const std::shared_ptr<SessionManagement>& session,
                          AddVectorFunc func) {
        session_ = session;
        addVectorFunc_ = func;
    }

    void connectSortVector(const std::shared_ptr<SessionManagement>& session,
                           SortVectorFunc func) {
        session_ = session;
        sortVectorFunc_ = func;
    }

    void connectPrintData(const std::shared_ptr<SessionManagement>& session,
                          PrintDataFunc func) {
        session_ = session;
        printDataFunc_ = func;
    }

    void connectExecuteBatch(const std::shared_ptr<SessionManagement>& session,
                             ExecuteBatchFunc func) {
        session_ = session;
        executeBatchFunc_ = func;
    }

    void connectSetSortStrategy(const std::shared_ptr<SessionManagement>& session,
                                SetSortStrategyFunc func) {
        session_ = session;
        setSortStrategyFunc_ = func;
    }

    void clickAddVector(const std::vector<int>& vec) {
        if (!addVectorFunc_) {
            logApp("[GUI] Brak dostępu do AddVector\n");
            return;
        }

        auto session = lockSession();
        if (!session) {
            return;
        }

        logApp("[GUI] Kliknięto AddVector\n");
        ((*session).*addVectorFunc_)(vec);
    }

    void clickSortVector(size_t index) {
        if (!sortVectorFunc_) {
            logApp("[GUI] Brak dostępu do SortVector\n");
            return;
        }

        auto session = lockSession();
        if (!session) {
            return;
        }

        logApp("[GUI] Kliknięto SortVector\n");
        ((*session).*sortVectorFunc_)(index);
    }

    void clickPrintData() {
        if (!printDataFunc_) {
            logApp("[GUI] Brak dostępu do PrintData\n");
            return;
        }

        auto session = lockSession();
        if (!session) {
            return;
        }

        logApp("[GUI] Kliknięto PrintData\n");
        ((*session).*printDataFunc_)();
    }

    void clickSetSortStrategy(SortStrategyId id) {
        if (!setSortStrategyFunc_) {
            logApp("[GUI] Brak dostępu do SetSortStrategy\n");
            return;
        }

        auto session = lockSession();
        if (!session) {
            return;
        }

        logApp("[GUI] Kliknięto SetSortStrategy\n");
        ((*session).*setSortStrategyFunc_)(id);
    }

    // ==================================
    // BUILDER — GUI zbiera polecenia zamiast wysyłać je natychmiast
    // ==================================
    DummyGui& queueAddVector(const std::vector<int>& vec) {
        logApp("[GUI] Dodaję AddVector do paczki poleceń\n");
        batchBuilder_.addVector(vec);
        return *this;
    }

    DummyGui& queueSortVector(size_t index) {
        logApp("[GUI] Dodaję SortVector do paczki poleceń\n");
        batchBuilder_.sortVector(index);
        return *this;
    }

    DummyGui& queuePrintData() {
        logApp("[GUI] Dodaję PrintData do paczki poleceń\n");
        batchBuilder_.printData();
        return *this;
    }

    CommandBatch buildBatch() {
        logApp("[GUI] Zamykam paczkę poleceń, gotowa do wysłania\n");
        return batchBuilder_.build();
    }

    // Wysyła zbudowaną paczkę do sesji — tylko jeśli Configurator przyznał dostęp
    // i obiekt SessionManagement nadal istnieje.
    void flushBatch() {
        if (!executeBatchFunc_) {
            logApp("[GUI] Brak dostępu do ExecuteBatch\n");
            return;
        }

        auto session = lockSession();
        if (!session) {
            return;
        }

        CommandBatch batch = buildBatch();
        logApp("[GUI] Wysyłam paczkę poleceń do sesji\n");
        ((*session).*executeBatchFunc_)(batch);
    }

private:
    std::shared_ptr<SessionManagement> lockSession() const {
        auto session = session_.lock();
        if (!session) {
            logApp(
                "[GUI] SessionManagement już nie istnieje — operacja anulowana\n");
        }
        return session;
    }

private:
    std::weak_ptr<SessionManagement> session_;

    AddVectorFunc addVectorFunc_ = nullptr;
    SortVectorFunc sortVectorFunc_ = nullptr;
    PrintDataFunc printDataFunc_ = nullptr;
    ExecuteBatchFunc executeBatchFunc_ = nullptr;
    SetSortStrategyFunc setSortStrategyFunc_ = nullptr;

    CommandBatchBuilder batchBuilder_;
};

// ==================================
// CONFIGURATOR
// ==================================
class Configurator {
public:
    void configureGui(DummyGui& gui,
                      const std::shared_ptr<SessionManagement>& session) {
        logApp("[Configurator] Przyznaję GUI dostęp do wybranych funkcji\n");

        gui.connectAddVector(session, &SessionManagement::addVectorFromGui);
        gui.connectSortVector(session, &SessionManagement::sortVectorFromGui);
        gui.connectPrintData(session, &SessionManagement::printDataFromGui);
        gui.connectExecuteBatch(session, &SessionManagement::executeBatch);
        gui.connectSetSortStrategy(session, &SessionManagement::setSortStrategyFromGui);
    }

    // Configurator jako jedyne miejsce, które ustala politykę: jakie strategie
    // sortowania w ogóle wolno podmieniać w trakcie działania programu
    void configureAllowedStrategies(SessionManagement& session,
                                     std::vector<SortStrategyId> allowed) {
        logApp("[Configurator] Ustalam dozwolone strategie sortowania\n");
        session.setAllowedStrategies(std::move(allowed));
    }
};

// ==================================
// SESSION AUDIT OBSERVER — obiekt, który sam kończy swój żywot
// wraz z zamknięciem sesji (żyje dokładnie tak długo, jak sesja)
// ==================================
class SessionAuditObserver : public ISessionObserver {
public:
    SessionAuditObserver() {
        logApp("[Audit] Tworzę obserwatora audytu — zaczynam nasłuchiwać sesji\n");
    }

    ~SessionAuditObserver() override {
        logApp("[Audit] Destruktor — zwalniam zasoby obserwatora audytu\n");
    }

    void onSessionEvent(const SessionEvent& event) override {
        switch (event.type) {
            case SessionEventType::VectorAdded:
                logApp("[Audit] Zarejestrowano: dodano wektor\n");
                break;

            case SessionEventType::SortRequested:
                logApp("[Audit] Zarejestrowano: żądanie sortowania\n");
                break;

            case SessionEventType::PrintRequested:
                logApp("[Audit] Zarejestrowano: żądanie wypisania danych\n");
                break;

            case SessionEventType::StrategyChangeRequested: {
                std::ostringstream oss;
                oss << "[Audit] Zarejestrowano: żądanie zmiany strategii na "
                    << sortStrategyIdName(event.strategyId) << "\n";
                logApp(oss.str());
                break;
            }

            case SessionEventType::SessionClosing:
                logApp("[Audit] Sesja się zamyka — kończę swój żywot\n");
                delete this;   // obiekt sam się niszczy w reakcji na zdarzenie
                break;
        }
    }
};

// ==================================
// SESSION ESTABLISHER — TEMPLATE METHOD
// ==================================
class SessionEstablisher {
public:
    virtual ~SessionEstablisher() = default;

    // TEMPLATE METHOD — stały szkielet algorytmu, nienadpisywalny
    void establish() {
        logApp("[SessionEstablisher] Rozpoczynam ustanawianie sesji\n");

        if (!checkPreconditions()) {
            logApp("[SessionEstablisher] Warunki wstępne niespełnione — przerywam\n");
            return;
        }

        connect();
        configure();      // hook — opcjonalny krok
        finalizeSetup();

        logApp("[SessionEstablisher] Sesja ustanowiona\n");
    }

protected:
    // hooki — mają domyślną implementację, podklasa może je nadpisać
    virtual bool checkPreconditions() { return true; }
    virtual void configure() {}

    // kroki wymagane — podklasa musi je zaimplementować
    virtual void connect() = 0;
    virtual void finalizeSetup() = 0;
};

// Konkretna realizacja dla Engine + SessionManagement
class EngineSessionEstablisher : public SessionEstablisher {
public:
    EngineSessionEstablisher(SessionManagement& session, Engine& engine)
        : session_(session), engine_(engine) {}

protected:
    bool checkPreconditions() override {
        logApp("[EngineSessionEstablisher] Sprawdzam dostępność silnika\n");
        return true;
    }

    void connect() override {
        session_.connectToEngine(engine_);
    }

    void configure() override {
        logApp("[EngineSessionEstablisher] Konfiguracja domyślna\n");
    }

    void finalizeSetup() override {
        session_.openSession();
    }

private:
    SessionManagement& session_;
    Engine& engine_;
};

// ==================================
// MAIN
// ==================================
int main() {
    // SERVICE LOCATOR — rejestrujemy usługi RAZ, na starcie programu.
    // Kolekcja usług w ServiceLocatorze trzyma je po typie: Logger (konsola)
    // i FileLogger (symulowany plik) współistnieją obok siebie bez konfliktu.
    auto consoleLogger = std::make_shared<Logger>();
    auto fileLogger = std::make_shared<FileLogger>("engine_log.txt");
    auto doSomething = std::make_shared<DoSomething>();
    auto loggerRegistration =
        ServiceLocator::instance().provide<Logger>(consoleLogger);
    if (!loggerRegistration) {
        std::cerr << serviceLocatorErrorMessage(loggerRegistration.error()) << "\n";
        return EXIT_FAILURE;
    }

    auto fileLoggerRegistration =
        ServiceLocator::instance().provide<FileLogger>(fileLogger);
    if (!fileLoggerRegistration) {
        std::cerr << serviceLocatorErrorMessage(fileLoggerRegistration.error()) << "\n";
        return EXIT_FAILURE;
    }

    // DoSomething celowo rejestrujemy inną ścieżką — provideRuntime() ustala
    // typ dynamicznie przez RTTI, ale również zwraca expected<void, Error>.
    auto doSomethingRegistration =
        ServiceLocator::instance().provideRuntime(doSomething);
    if (!doSomethingRegistration) {
        std::cerr << serviceLocatorErrorMessage(doSomethingRegistration.error()) << "\n";
        return EXIT_FAILURE;
    }

    // Cała reszta programu woła appLogger() (konsola), tak jak wcześniej.
    // appFileLogger() teraz tylko symuluje zapis — bezpieczne wszędzie.
    auto startFileLog = logFile("=== Start programu ===\n");
    if (!startFileLog) {
        std::cerr << serviceLocatorErrorMessage(startFileLog.error()) << "\n";
        return EXIT_FAILURE;
    }

    auto doSomethingResult = appDoSomethingByPointer();
    if (!doSomethingResult) {
        std::cerr << serviceLocatorErrorMessage(doSomethingResult.error()) << "\n";
        return EXIT_FAILURE;
    }
    doSomethingResult->get().do_();

    Engine engine;
    auto session = std::make_shared<SessionManagement>();
    DummyGui gui;
    Configurator configurator;

    gui.clickAddVector({3, 1, 2});   // brak dostępu

    // Ustanawianie sesji przez Template Method
    // (connectToEngine wewnątrz automatycznie robi session.attach(&engine))
    EngineSessionEstablisher establisher(*session, engine);
    establisher.establish();

    configurator.configureGui(gui, session);

    // Configurator ustala politykę RAZ, na starcie: wolno tylko Ascending i Descending
    configurator.configureAllowedStrategies(*session, {SortStrategyId::Ascending,
                                                        SortStrategyId::Descending});

    // Dodatkowy obserwator, alokowany na stercie — jego cykl życia jest
    // całkowicie powiązany z sesją: zniknie sam, gdy sesja się zamknie
    auto* audit = new SessionAuditObserver();
    session->attach(audit);

    gui.clickAddVector({3, 1, 2});
    gui.clickAddVector({9, 5, 7});
    gui.clickPrintData();

    // Domyślna strategia (AscendingSort) — ustawiona w konstruktorze Engine
    gui.clickSortVector(0);
    gui.clickPrintData();

    // STRATEGY w akcji — podmiana na dozwoloną strategię
    gui.clickSetSortStrategy(SortStrategyId::Descending);
    gui.clickSortVector(1);
    gui.clickPrintData();

    // Próba podmiany na strategię SPOZA whitelisty Configuratora — zostanie odrzucona
    gui.clickSetSortStrategy(SortStrategyId::Bubble);
    gui.clickAddVector({5, 4, 3, 2, 1});
    gui.clickSortVector(2);      // nadal zadziała strategią Descending, bo Bubble nie wszedł
    gui.clickPrintData();

    // BUILDER — GUI zbiera kilka poleceń w jedną paczkę zamiast wysyłać
    // każde osobno, a potem wysyła je hurtem; sesja jedzie po nich po kolei
    // i dla każdego generuje normalny event (Engine i Audit widzą to tak samo
    // jak pojedyncze kliknięcia).
    gui.queueAddVector({8, 6, 4})
       .queueSortVector(3)
       .queuePrintData();
    gui.flushBatch();

    // Zamknięcie sesji = zdarzenie SessionClosing do WSZYSTKICH obserwatorów:
    // Engine sam się zatrzyma, a SessionAuditObserver sam wywoła swój destruktor
    session->closeSession();

    gui.clickAddVector({100, 200});  // obiekt istnieje, ale sesja jest zamknięta

    // Symulujemy zniszczenie SessionManagement. DummyGui nadal ma przyznane
    // wskaźniki do metod, ale weak_ptr wygasł, więc wywołanie jest bezpiecznie
    // anulowane zamiast dereferencji wiszącego wskaźnika.
    session.reset();
    gui.clickAddVector({300, 400});

    auto endFileLog = logFile("=== Koniec programu ===\n");
    if (!endFileLog) {
        std::cerr << serviceLocatorErrorMessage(endFileLog.error()) << "\n";
        return EXIT_FAILURE;
    }

    return 0;
}